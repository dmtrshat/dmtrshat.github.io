{
  "$schema": "https://raw.githubusercontent.com/persevie/grimoire-css/refs/heads/main/src/core/config-schema.json",
  "version": "1.8.1",
  "variables": {
    "main-font": "'IBM_Plex Mono', monospace",
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px",
    "tr-fast": "100ms"
  },
  "projects": [
    {
      "projectName": "index",
      "inputPaths": [
        "src/components/ExternalLink.astro",
        "src/components/NavLink.astro",
        "src/layouts/BaseLayout.astro",
        "src/pages/index.astro",
        "src/scripts/player/player.mjs"
      ],
      "outputDirPath": "public/css",
      "singleOutputFileName": "index.css"
    },
    {
      "projectName": "404",
      "inputPaths": ["src/pages/404.astro"],
      "outputDirPath": "public/css",
      "singleOutputFileName": "404.css"
    }
  ],
  "shared": [
    {
      "outputPath": "public/css/shared.css",
      "styles": ["./grimoire/reset.css", "./grimoire/themes.css"]
    }
  ]
}
